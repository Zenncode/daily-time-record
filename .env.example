DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dtr?schema=public"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# Optional for multi-instance deployments: set to a shared Redis URL to broadcast realtime updates across app servers.
REDIS_URL=""
APP_TIMEZONE="Asia/Manila"
# Used by db:seed to create the initial administrator.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@dtr.com"
ADMIN_PASSWORD="123456"
